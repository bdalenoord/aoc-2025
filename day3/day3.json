.split(\"\\n\").filter(item => item.trim().length > 0) }}","type":"array"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[448,192],"id":"f765ff8b-301c-494e-b10e-0ece38d0a637","name":"P1 - Split into array of rows"},{"parameters":{"fieldToSplitOut":"data","options":{}},"type":"n8n-nodes-base.splitOut","typeVersion":1,"position":[672,192],"id":"31f26121-a83b-4f0b-a066-5735a4ca3519","name":"P1 - split out rows into items"},{"parameters":{"assignments":{"assignments":[{"id":"222ae80e-795a-4ff7-ae5d-1b13db502b3c","name":"data","value":"={{ $json.data.split(\"\").map(item => Number(item)) }}","type":"array"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[896,192],"id":"383a973c-add9-49d6-92a6-b46b648b39f9","name":"P1 - Split out lines into individual items"},{"parameters":{"assignments":{"assignments":[{"id":"18633fcb-8796-4f7f-b0fd-099c0cc84ddf","name":"data","value":"={{ $json.data.map((item, index) => {\n  const possibleNeighbours = $json.data.slice(index + 1);\n  const highestNeighbour = possibleNeighbours.length > 0  ? possibleNeighbours.max() : null;\n  return highestNeighbour != null ? Number(`${item}${highestNeighbour}`) : item;\n}).max() }}","type":"number"}]},"options":{"ignoreConversionErrors":false}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[1120,192],"id":"88f4abed-9fea-4cb5-b566-68729228d43b","name":"P1 - find highest combination"},{"parameters":{"fieldsToSummarize":{"values":[{"aggregation":"sum","field":"data"}]},"options":{}},"type":"n8n-nodes-base.summarize","typeVersion":1.1,"position":[1344,192],"id":"a324c5b6-821e-4f7e-b353-28ef370ddb9b","name":"P1 - Sum highest joltages"},{"parameters":{"assignments":{"assignments":[{"id":"ddaa80f8-9918-4ab4-95fa-390b07541653","name":"data","value":"={{ $json.data.split(\"\\n\").filter(item => item.trim().length > 0) }}","type":"array"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[448,384],"id":"49776c5e-c012-4367-8d39-23fbf35071ae","name":"P2 Sample - Split into array of rows"},{"parameters":{"fieldToSplitOut":"data","options":{}},"type":"n8n-nodes-base.splitOut","typeVersion":1,"position":[672,384],"id":"eadc3c94-483d-4a69-b25f-596bfb0dcac7","name":"P2 Sample - split out rows into items"},{"parameters":{"assignments":{"assignments":[{"id":"222ae80e-795a-4ff7-ae5d-1b13db502b3c","name":"data","value":"={{ (()=>{\n  const findNext = (line, fromIdx, remaining) => {\n    let idx = -1;\n    let val = 0;\n\n    // Find highest combination in sequence that leaves enough space for the bank to be completed\n    for (let i = fromIdx; i < line.length - (remaining - 1); i++) {\n      const currVal = parseInt(line[i]);\n      if (currVal > val) {\n        idx = i;\n        val = currVal;\n      }\n    }\n\n    if (remaining === 1) return `${val}`;\n\n    return `${val}${findNext(line, idx + 1, remaining - 1)}`\n  };\n\n  return parseInt(findNext($json.data, 0, 12))\n})() }}","type":"number"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[896,384],"id":"b34b0b36-e120-4a21-8563-a08cb202aa84","name":"P2 Sample - Split out lines into individual items"},{"parameters":{"assignments":{"assignments":[{"id":"ddaa80f8-9918-4ab4-95fa-390b07541653","name":"data","value":"={{ $json.data.split(\"\\n\").filter(item => item.trim().length > 0) }}","type":"array"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[448,576],"id":"61dfdb98-c1e2-429b-b69d-67e79bbe3695","name":"P2 - Split into array of rows"},{"parameters":{"fieldToSplitOut":"data","options":{}},"type":"n8n-nodes-base.splitOut","typeVersion":1,"position":[672,576],"id":"fd83429b-0a50-4b2d-9653-f2b2c86654f3","name":"P2 - split out rows into items"},{"parameters":{"assignments":{"assignments":[{"id":"222ae80e-795a-4ff7-ae5d-1b13db502b3c","name":"data","value":"={{ (()=>{\n  const findNext = (line, fromIdx, remaining) => {\n    let idx = -1;\n    let val = 0;\n\n    // Find highest combination in sequence that leaves enough space for the bank to be completed\n    for (let i = fromIdx; i < line.length - (remaining - 1); i++) {\n      const currVal = parseInt(line[i]);\n      if (currVal > val) {\n        idx = i;\n        val = currVal;\n      }\n    }\n\n    if (remaining === 1) return `${val}`;\n\n    return `${val}${findNext(line, idx + 1, remaining - 1)}`\n  };\n\n  return parseInt(findNext($json.data, 0, 12))\n})() }}","type":"number"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[896,576],"id":"133e1f09-1391-40ba-bae6-2cdc715d114d","name":"P2 - Split out lines into individual items"},{"parameters":{"fieldsToSummarize":{"values":[{"aggregation":"sum","field":"data"}]},"options":{}},"type":"n8n-nodes-base.summarize","typeVersion":1.1,"position":[1120,576],"id":"1452f1d0-750b-4418-b1bd-4e0189137530","name":"P2 - Sum the total joltage"},{"parameters":{"fieldsToSummarize":{"values":[{"aggregation":"sum","field":"data"}]},"options":{}},"type":"n8n-nodes-base.summarize","typeVersion":1.1,"position":[1120,384],"id":"db7a3631-4333-4e4d-ba04-2e74e02870a2","name":"P2 Sample - Sum the total joltage"}],"connections":{"When clicking ‘Execute workflow’":{"main":[[{"node":"P1 Sample - Read input","type":"main","index":0},{"node":"P1 - Read input","type":"main","index":0},{"node":"P2 Sample - Read input","type":"main","index":0},{"node":"P2 - Read input","type":"main","index":0}]]},"P1 Sample - Read input":{"main":[[{"node":"P1 Sample - Extract from File","type":"main","index":0}]]},"P1 - Read input":{"main":[[{"node":"P1 - Extract from File","type":"main","index":0}]]},"P2 Sample - Read input":{"main":[[{"node":"P2 Sample - Extract from File","type":"main","index":0}]]},"P2 - Read input":{"main":[[{"node":"P2 - Extract from File","type":"main","index":0}]]},"P1 Sample - Extract from File":{"main":[[{"node":"P1 Sample - Split into array of rows","type":"main","index":0}]]},"P1 Sample - Split into array of rows":{"main":[[{"node":"P1 Sample - spli