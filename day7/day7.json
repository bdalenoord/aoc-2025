[{"updatedAt":"2025-12-07T09:33:31.531Z","createdAt":"2025-12-07T08:59:36.864Z","id":"KCIKXuzbHXPiqG28","name":"AOC 2025 - day 7","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{},"type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[0,96],"id":"fb5f6fe2-2c7c-47e6-a079-24cd36839bfb","name":"When clicking ‘Execute workflow’"},{"parameters":{"fileSelector":"/opt/aoc/day7/sample.txt","options":{}},"type":"n8n-nodes-base.readWriteFile","typeVersion":1,"position":[224,0],"id":"519b53ed-954d-4890-bcc5-4b0ce8d4ba77","name":"Read Sample input"},{"parameters":{"operation":"text","options":{}},"type":"n8n-nodes-base.extractFromFile","typeVersion":1.1,"position":[448,96],"id":"36c27d64-80b9-4fb6-8703-886b9db5f840","name":"Extract from File"},{"parameters":{"assignments":{"assignments":[{"id":"8dd2ebd7-082d-4937-80e9-8c03b5e077c6","name":"grid","value":"={{ \n  $json.data.split(\"\\n\").filter(Boolean).map((item) => item.split(\"\"))\n}}","type":"array"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[672,96],"id":"b8a84c74-a28d-438a-85ce-24533dd742f1","name":"Split into grid"},{"parameters":{"assignments":{"assignments":[{"id":"99558eb2-5f0e-4fc7-9d96-9b18893e0025","name":"start","value":"={{ \n  { x: $json.grid[0].indexOf('S'), y: 0 }\n}}","type":"object"},{"id":"ca9a8665-e449-496e-83ac-d10630c42dcc","name":"grid","value":"={{ $json.grid }}","type":"array"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[896,96],"id":"6d111d73-aeff-4ea8-b1bc-f6a3ef7a20ea","name":"Determine start"},{"parameters":{"jsCode":"const input = $input.first().json\nconst grid = input.grid;\n\nlet splitCount = 0;\n\nfunction beamFrom(x, startingY) {\n  for (let y = startingY; y < grid.length; y++) {\n    const valueAt = grid[y][x];\n    if (valueAt === \"|\") {\n      return;\n    } else if (valueAt === \"^\") {\n      splitCount++;\n      beamFrom(x - 1, y);\n      beamFrom(x + 1, y);\n      break;\n    } else {\n      grid[y][x] = \"|\"\n    }\n  }\n}\n\nbeamFrom(input.start.x, input.start.y + 1)\n\nreturn {\n  splitCount: splitCount,\n  start: input.start,\n  grid: grid.map((item) => item.join(\"\"))\n}"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1120,0],"id":"16bc079b-02d2-4946-b24c-209b97c4b732","name":"Beamforming"},{"parameters":{"fileSelector":"/opt/aoc/day7/input.txt","options":{}},"type":"n8n-nodes-base.readWriteFile","typeVersion":1,"position":[224,192],"id":"edd63062-2619-4925-8f9b-3c4783de3b04","name":"Read input"},{"parameters":{"jsCode":"const input = $input.first().json\nconst grid = input.grid;\n\nlet timelineCount = 0;\n\nconst cache = {};\n\nfunction beamFrom(x, startingY) {\n  const cacheKey = `${x},${startingY}`;\n  let result = 0;\n  if (typeof cache[cacheKey] != 'undefined') {\n    result = cache[cacheKey];\n  } else {\n    for (let y = startingY; y < grid.length; y++) {\n      const valueAt = grid[y][x];\n      if (valueAt === \"^\") {\n        result += beamFrom(x - 1, y);\n        result += beamFrom(x + 1, y);\n        break;\n      }\n    }\n    if (result === 0) result = 1;\n    cache[cacheKey] = result;\n  }\n  return result;\n}\n\ntimelineCount = beamFrom(input.start.x, input.start.y + 1)\n\nreturn {\n  timelineCount,\n  start: input.start,\n  grid: grid.map((item) => item.join(\"\"))\n}"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1120,192],"id":"471baa23-7f9e-4bd8-8333-5ad926ca8e3c","name":"Quantum theory"}],"connections":{"When clicking ‘Execute workflow’":{"main":[[{"node":"Read Sample input","type":"main","index":0},{"node":"Read input","type":"main","index":0}]]},"Read Sample input":{"main":[[{"node":"Extract from File","type":"main","index":0}]]},"Extract from File":{"main":[[{"node":"Split into grid","type":"main","index":0}]]},"Split into grid":{"main":[[{"node":"Determine start","type":"main","index":0}]]},"Determine start":{"main":[[{"node":"Beamforming","type":"main","index":0},{"node":"Quantum theory","type":"main","index":0}]]},"Read input":{"main":[[{"node":"Extract from File","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":null,"meta":null,"pinData":{},"versionId":"0f0b59c7-be77-48ff-ba2d-5944eb492b38","versionCounter":4,"triggerCount":0,"tags":[],"shared":[{"updatedAt":"2025-12-07T08:59:36.864Z","createdAt":"2025-12-07T08:59:36.864Z","role":"workflow:owner","workflowId":"KCIKXuzbHXPiqG28","projectId":"OFgjjSQ4AhpG1nTx","project":{"updatedAt":"2025-12-01T07:43:08.916Z","createdAt":"2025-12-01T07:41:32.756Z","id":"OFgjjSQ4AhpG1nTx","name":"Bas Dalenoord <mail@basdalenoord.nl>","type":"personal","icon":null,"description":null}}]}]