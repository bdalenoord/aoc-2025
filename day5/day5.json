parseInt(range[1])\n      }) \n  )\n}}","type":"array"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[32,-128],"id":"13224ec8-09d6-4d03-b83c-5cdc3484bf59","name":"Determine freshly available"},{"parameters":{"assignments":{"assignments":[{"id":"934ae14b-735d-43a0-95a2-35332fd9a86d","name":"freshlyAvailableAmount","value":"={{ $json.freshlyAvailable.length }}","type":"number"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[240,-128],"id":"d153cfcb-fd66-4322-8fe3-e110f09c6d63","name":"Count amount of freshly available"},{"parameters":{"assignments":{"assignments":[{"id":"d9abbc5b-d08d-4a12-b693-4110a7285cb9","name":"fresh","value":"={{ (()=>{\n  let total = 0;\n\n  const fresh = $json.fresh;\n  fresh.sort((a, b) => a[0] - b[0]);\n\n  // Consider the first element initially\n  let rangeStart = fresh[0][0];\n  let rangeEnd = fresh[0][1];\n\n  // Start looping after the first element to compare other ranges\n  for (let i = 1; i < fresh.length; i++) {\n    let currentRange = fresh[i];\n    \n    if (currentRange[1] > rangeEnd) {\n      if (currentRange[0] <= rangeEnd) {\n        rangeEnd = currentRange[1];\n      } else {\n        total += rangeEnd - rangeStart + 1;\n        rangeStart = currentRange[0];\n        rangeEnd = currentRange[1];\n      }\n    }\n  }\n\n  // Include the last range as well\n  total += rangeEnd - rangeStart + 1;\n\n  return total;\n})() }}","type":"number"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[32,64],"id":"6dfe9122-9977-4000-8692-222cb0a16f74","name":"Determine freshly available amounts"}],"connections":{"When clicking ‘Execute workflow’":{"main":[[{"node":"Read/Write Files from Disk","type":"main","index":0},{"node":"Read sample input","type":"main","index":0}]]},"Read sample input":{"main":[[{"node":"Extract from File","type":"main","index":0}]]},"Read/Write Files from Disk":{"main":[[{"node":"Extract from File","type":"main","index":0}]]},"Extract from 