[{"updatedAt":"2025-12-06T09:31:03.612Z","createdAt":"2025-12-06T08:06:19.608Z","id":"Y0w6rD8BXyse0Nx5","name":"AOC 2025 - Day 6","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{},"type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[0,96],"id":"112a7192-1b28-41eb-b1a7-fbdaa4323afc","name":"When clicking ‘Execute workflow’"},{"parameters":{"fileSelector":"/opt/aoc/day6/sample.txt","options":{}},"type":"n8n-nodes-base.readWriteFile","typeVersion":1,"position":[224,0],"id":"a2dd68c2-e0a1-4b35-9417-cfa089500b48","name":"Read Sample input"},{"parameters":{"operation":"text","options":{}},"type":"n8n-nodes-base.extractFromFile","typeVersion":1.1,"position":[448,96],"id":"481f9580-12d0-48ab-b0f1-1f2fa8a19355","name":"Extract from File"},{"parameters":{"assignments":{"assignments":[{"id":"9fee5fb2-bbff-494f-a53e-fa2f9f9cdec4","name":"data","value":"={{ \n  $json.data\n    // Split rows\n    .split(\"\\n\").filter(Boolean)\n    // Split cols\n    .map((item) => item.split(/ /)).map((item) => item.filter(Boolean))\n}}","type":"array"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[672,0],"id":"a1623abc-7050-4050-aec4-2ba4d8d90f02","name":"Split into rows and cols"},{"parameters":{"assignments":{"assignments":[{"id":"84189fab-de2d-40c4-84be-eff2317a230d","name":"data","value":"={{ \n  $json.data[0].map((_, i) => {\n    return { \n      in: $json.data.map(item => item[i])\n    }\n  })\n}}","type":"array"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[896,0],"id":"d0f4769f-eba3-4e29-a53a-b7b25efa9be0","name":"Rotate the workbook"},{"parameters":{"fieldToSplitOut":"data","options":{}},"type":"n8n-nodes-base.splitOut","typeVersion":1,"position":[1120,0],"id":"bf2ac1a2-9bf0-4977-aecd-b87f412e1a19","name":"Split Out"},{"parameters":{"fieldsToSummarize":{"values":[{"aggregation":"sum","field":"out.res"}]},"options":{}},"type":"n8n-nodes-base.summarize","typeVersion":1.1,"position":[1568,0],"id":"87e7778c-c45b-4c06-a35c-c3cb917cd18c","name":"Summarize the total"},{"parameters":{"fileSelector":"/opt/aoc/day6/input.txt","options":{}},"type":"n8n-nodes-base.readWriteFile","typeVersion":1,"position":[224,192],"id":"40ef0cbd-8f4d-4a63-aa45-266fd7b4aeda","name":"Read real input"},{"parameters":{"assignments":{"assignments":[{"id":"25bd0da7-82bd-4620-85a2-f1e972ae9100","name":"in","value":"={{ $json.in }}","type":"array"},{"id":"117e875c-36b0-494e-9b29-70ad7b7ffff7","name":"out","value":"={{ (()=>{\n  const input = [...$json.in];\n  const op = input.pop();\n  const initial = parseInt(input.pop());\n\n  return { \n    nums: input,\n    op: op,\n    res: input.reduce((acc, num) => {\n        if (op === '*') {\n          return acc * parseInt(num);\n        } else {\n          return acc + parseInt(num);\n        }\n      }, initial) \n  }\n})() }}","type":"object"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[1344,0],"id":"270f8d37-08eb-4d47-963c-92550a16a89e","name":"P1 - Calculate each row"},{"parameters":{"assignments":{"assignments":[{"id":"9fee5fb2-bbff-494f-a53e-fa2f9f9cdec4","name":"data","value":"={{ \n  $json.data\n    // Split rows\n    .split(\"\\n\").filter(Boolean)\n}}","type":"array"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[672,192],"id":"196527d9-663f-47ea-8dbd-9276a51a95c1","name":"P2 - Split into rows"},{"parameters":{"assignments":{"assignments":[{"id":"9edaf136-f34f-4300-bf13-7d8d36f88258","name":"data","value":"={{ $json.data.slice(0, -1) }}","type":"array"},{"id":"9abd8729-b019-4906-8c1b-ef43cbcc4ff5","name":"operators","value":"={{ $json.data.pop().matchAll(/\\S/g).map((x)=>[x[0],x.index]).toArray() }}","type":"array"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[896,192],"id":"340a0fcc-550e-452a-823e-3d687860bebe","name":"Split operators from data, determine col starts from operators"},{"parameters":{"assignments":{"assignments":[{"id":"e5be978b-883f-4c9d-a437-85c28c8953d5","name":"data","value":"={{ $json.data }}","type":"array"},{"id":"2e4a7309-a447-474f-a940-51c184261b82","name":"operators","value":"={{ $json.operators }}","type":"array"},{"id":"9ded6b82-573d-4a27-abe3-c6c1f2ceb38b","name":"results","value":"={{ \n// Calculate column results\n$json.operators.map((operator, idx) => {\n  const nextOperator = idx < $json.operators.length ? $json.operators[idx + 1] : null;\n\n  const nums = $json.data\n    .map((item) => item.substring(operator[1], nextOperator?.at(1)));\n  const firstNum = nums.shift().split(\"\");\n\n  const cols = firstNum.map((firstCol, idx) => {\n    const otherCols = nums.map((num) => num.charAt(idx))\n\n    return firstCol + otherCols.join(\"\")\n  })\n    .map((col) => parseInt(col.trim()))\n    .filter(Boolean)\n    .reverse()\n\n  const firstCol = cols.shift();\n\n  const res = cols.reduce((acc, col) => {\n    if (operator[0] === '*') {\n      return acc * col\n    } else {\n      return acc + col\n    }\n  }, firstCol)\n\n  return { res, cols: [firstCol, ...cols], operator };\n}) \n}}","type":"array"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[1120,192],"id":"2f42f974-477d-4751-8dbf-0b50a70b5f5c","name":"Calculate cols"},{"parameters":{"fieldsToSummarize":{"values":[{"aggregation":"sum","field":"res"}]},"options":{}},"type":"n8n-nodes-base.summarize","typeVersion":1.1,"position":[1568,192],"id":"c83cc578-85a3-4f11-b8c8-1195fde9b1e9","name":"Summarize P2"},{"parameters":{"fieldToSplitOut":"results","options":{}},"type":"n8n-nodes-base.splitOut","typeVersion":1,"position":[1344,192],"id":"2ca5b273-1e3e-4e2a-8050-3d5d0b21d611","name":"P2 - Split out"}],"connections":{"When clicking ‘Execute workflow’":{"main":[[{"node":"Read Sample input","type":"main","index":0},{"node":"Read real input","type":"main","index":0}]]},"Read Sample input":{"main":[[{"node":"Extract from File","type":"main","index":0}]]},"Extract from File":{"main":[[{"node":"Split into rows and cols","type":"main","index":0},{"node":"P2 - Split into rows","type":"main","index":0}]]},"Split into rows and cols":{"main":[[{"node":"Rotate the workbook","type":"main","index":0}]]},"Rotate the workbook":{"main":[[{"node":"Split Out","type":"main","index":0}]]},"Split Out":{"main":[[{"node":"P1 - Calculate each row","type":"main","index":0}]]},"Read real input":{"main":[[{"node":"Extract from File","type":"main","index":0}]]},"P1 - Calculate each row":{"main":[[{"node":"Summarize the total","type":"main","index":0}]]},"P2 - Split into rows":{"main":[[{"node":"Split operators from data, determine col starts from operators","type":"main","index":0}]]},"Split operators from data, determine col starts from operators":{"main":[[{"node":"Calculate cols","type":"main","index":0}]]},"Calculate cols":{"main":[[{"node":"P2 - Split out","type":"main","index":0}]]},"P2 - Split out":{"main":[[{"node":"Summarize P2","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":null,"meta":null,"pinData":{},"versionId":"e37b07ae-628b-409e-aa81-6def9f364fd6","versionCounter":4,"triggerCount":0,"tags":[],"shared":[{"updatedAt":"2025-12-06T08:06:19.608Z","createdAt":"2025-12-06T08:06:19.608Z","role":"workflow:owner","workflowId":"Y0w6rD8BXyse0Nx5","projectId":"OFgjjSQ4AhpG1nTx","project":{"updatedAt":"2025-12-01T07:43:08.916Z","createdAt":"2025-12-01T07:41:32.756Z","id":"OFgjjSQ4AhpG1nTx","name":"Bas Dalenoord <mail@basdalenoord.nl>","type":"personal","icon":null,"description":null}}]}]